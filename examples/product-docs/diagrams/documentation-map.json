{
  "id": "documentation-map",
  "kind": "architecture",
  "title": "Aurelius publishing architecture",
  "description": "Three zones show how versioned Markdown, diagrams, and metadata pass through renderers and indexes to become a site, accessible SVG, and structured agent interfaces.",
  "zones": [
    { "label": "VERSIONED SOURCE", "x": 40, "y": 48, "width": 400, "height": 616 },
    { "label": "BUILD AND PROJECTION", "x": 560, "y": 48, "width": 400, "height": 616 },
    { "label": "PUBLISHED READING", "x": 1080, "y": 48, "width": 600, "height": 616 }
  ],
  "nodes": [
    { "id": "markdown-source", "kind": "input", "tag": "CONTENT", "label": "Markdown", "detail": "pages and decisions", "x": 88, "y": 120, "width": 256, "height": 112 },
    { "id": "diagram-source", "kind": "input", "tag": "DIAGRAMS", "label": "Semantic JSON", "detail": "zones and relationships", "x": 88, "y": 304, "width": 256, "height": 112 },
    { "id": "metadata-source", "kind": "input", "tag": "METADATA", "label": "Relations and sources", "detail": "IDs and traceability", "x": 88, "y": 488, "width": 256, "height": 112 },
    { "id": "html-renderer", "kind": "focal", "tag": "HTML", "label": "Editorial renderer", "detail": "accessible structure", "x": 608, "y": 120, "width": 256, "height": 112 },
    { "id": "svg-renderer", "kind": "backend", "tag": "SVG", "label": "Diagram renderer", "detail": "orthogonal layout", "x": 608, "y": 304, "width": 256, "height": 112 },
    { "id": "indexer", "kind": "store", "tag": "INDEX", "label": "Index and graph", "detail": "search and relations", "x": 608, "y": 488, "width": 256, "height": 112 },
    { "id": "website", "kind": "backend", "tag": "SITE", "label": "Human reading", "detail": "static HTML", "x": 1400, "y": 120, "width": 224, "height": 112 },
    { "id": "svg-output", "kind": "optional", "tag": "SVG", "label": "Accessible diagram", "detail": "copy and print", "x": 1400, "y": 304, "width": 224, "height": 112 },
    { "id": "agent-api", "kind": "store", "tag": "AGENTS", "label": "API and corpus", "detail": "JSON and llms.txt", "x": 1400, "y": 488, "width": 224, "height": 112 }
