    { "id": "publish-api", "from": "indexer", "to": "agent-api", "label": "EXPOSE", "tone": "link" },
    { "id": "include-diagrams", "from": "markdown-source", "to": "diagram-source", "label": "INCLUDE" },
    { "id": "describe-content", "from": "diagram-source", "to": "metadata-source", "label": "DESCRIBE" },
    { "id": "include-svg", "from": "html-renderer", "to": "svg-renderer", "label": "INCLUDE" },
    { "id": "index-output", "from": "svg-renderer", "to": "indexer", "label": "DESCRIBE" }
